DATABASE_URL="file:./dev.db"

# Get free test-mode keys at https://dashboard.razorpay.com/app/keys (no KYC needed for test mode)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Optional — order confirmation emails. Free API key at https://resend.com/api-keys
# (Resend's sandbox sender "onboarding@resend.dev" only delivers to your own signup
# email until you verify a domain, so add STORE_FROM_EMAIL once you have one.)
RESEND_API_KEY=
STORE_FROM_EMAIL=
